PORT=5000
# Neon Postgres connection string (from Neon dashboard -> Connect -> Node.js)
# Use the pooled + ssl version for serverless hosts (Render/Koyeb):
# postgresql://user:password@ep-xxx.neon.tech/eatcode?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/eatcode?sslmode=require"

# Frontend URL for CORS (your Netlify URL + local dev)
FRONTEND_URL="https://yourapp.netlify.app"

NODE_ENV=development

# Legacy, only needed once to copy data from Mongo -> Postgres:
# MONGO_URL="mongodb://127.0.0.1:27017/eatcode"
